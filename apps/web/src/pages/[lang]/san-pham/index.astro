---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/product/ProductCard.astro';
import { isLocale, t, type Locale } from '../../../i18n/ui';
import { getMenus, getProducts, getSiteSettings } from '../../../lib/strapi';

export function getStaticPaths() {
  return [{ params: { lang: 'vi' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang || 'vi';
if (!isLocale(lang)) return Astro.redirect('/vi');
const locale = lang as Locale;
const copy = t(locale);

const [settings, menus, products] = await Promise.all([
  getSiteSettings(locale),
  getMenus(locale),
  getProducts(locale),
]);
const headerMenu = menus.find((m) => m.location === 'header')?.items || [];
---

<BaseLayout
  locale={locale}
  settings={settings}
  menuItems={headerMenu}
  title={`${copy.products.title} | ${settings.siteName}`}
  description={copy.products.subtitle}
>
  <section class="mx-auto max-w-6xl px-5 py-16 md:px-8">
    <p class="text-xs uppercase tracking-[0.2em] text-copper">{copy.brand}</p>
    <h1 class="mt-3 font-display text-4xl font-semibold md:text-5xl">{copy.products.title}</h1>
    <p class="mt-4 max-w-2xl text-ink/65">{copy.products.subtitle}</p>
    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((product) => (
        <ProductCard product={product} locale={locale} />
      ))}
    </div>
  </section>
</BaseLayout>
