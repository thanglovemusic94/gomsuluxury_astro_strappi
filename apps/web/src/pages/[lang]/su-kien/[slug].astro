---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { isLocale, t, type Locale } from '../../../i18n/ui';
import { formatDate } from '../../../lib/format';
import { getEventBySlug, getEvents, getMenus, getSiteSettings } from '../../../lib/strapi';

const lang = Astro.params.lang || 'vi';
const slug = Astro.params.slug || '';
if (!isLocale(lang)) return Astro.redirect('/vi');
const locale = lang as Locale;
const copy = t(locale);

const [settings, menus, event] = await Promise.all([
  getSiteSettings(locale),
  getMenus(locale),
  getEventBySlug(locale, slug),
]);

if (!event) return Astro.redirect(`/${locale}/su-kien`);
const headerMenu = menus.find((m) => m.location === 'header')?.items || [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  description: event.excerpt || event.seo?.metaDescription,
  startDate: event.startDate,
  endDate: event.endDate || undefined,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: event.location
    ? {
        '@type': 'Place',
        name: event.location,
        address: event.location,
      }
    : undefined,
  image: event.cover?.url,
  organizer: {
    '@type': 'Organization',
    name: settings.siteName,
  },
};
---

<BaseLayout
  locale={locale}
  settings={settings}
  menuItems={headerMenu}
  seo={event.seo}
  title={event.seo?.metaTitle || event.title}
  description={event.seo?.metaDescription || event.excerpt}
>
  <article>
    <header class="relative min-h-[42vh] overflow-hidden bg-ink text-porcelain sm:min-h-[52vh]">
      {event.cover?.url ? (
        <img
          src={event.cover.url}
          alt={event.cover.alternativeText || event.title}
          class="absolute inset-0 h-full w-full object-cover"
        />
      ) : (
        <div class="absolute inset-0 bg-gradient-to-br from-ink via-ink-soft to-celadon-deep"></div>
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/50 to-ink/20"></div>
      <div class="relative mx-auto flex min-h-[42vh] max-w-6xl flex-col justify-end px-4 pb-10 pt-20 sm:min-h-[52vh] sm:px-5 sm:pb-12 sm:pt-24 md:px-8">
        <p class="text-[10px] uppercase tracking-[0.2em] text-sand sm:text-xs">{copy.events.title}</p>
        <h1 class="mt-3 max-w-3xl font-display text-3xl font-semibold sm:mt-4 sm:text-4xl md:text-6xl">{event.title}</h1>
        <p class="mt-3 max-w-2xl text-sm text-porcelain/75 sm:mt-4 sm:text-base">{event.excerpt}</p>
      </div>
    </header>

    <section class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:gap-10 sm:px-5 sm:py-14 md:grid-cols-[1.4fr_0.8fr] md:px-8">
      <div>
        {event.content ? (
          <div class="prose prose-neutral max-w-none text-sm text-ink/80 sm:text-base" set:html={event.content} />
        ) : (
          <p class="text-ink/70">{event.excerpt}</p>
        )}
      </div>
      <aside class="h-fit bg-mist/70 p-5 sm:p-6 md:sticky md:top-24">
        <p class="text-xs uppercase tracking-[0.16em] text-copper">{copy.events.when}</p>
        <p class="mt-2 text-sm font-medium">{formatDate(event.startDate, locale)}</p>
        {event.endDate && <p class="text-sm text-ink/60">→ {formatDate(event.endDate, locale)}</p>}
        {event.location && (
          <>
            <p class="mt-6 text-xs uppercase tracking-[0.16em] text-copper">{copy.events.where}</p>
            <p class="mt-2 text-sm">{event.location}</p>
          </>
        )}
        {event.registrationUrl && (
          <a
            href={event.registrationUrl}
            class="mt-8 inline-flex min-h-12 w-full items-center justify-center bg-ink px-5 py-3 text-xs font-semibold uppercase tracking-[0.14em] text-porcelain hover:bg-celadon-deep"
          >
            {copy.cta.register}
          </a>
        )}
      </aside>
    </section>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
