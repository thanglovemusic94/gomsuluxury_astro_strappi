---
import type { Locale } from '../../i18n/ui';
import { t } from '../../i18n/ui';
import type { Article } from '../../lib/types';
import { formatDate } from '../../lib/format';

type Props = {
  article: Article;
  locale: Locale;
};

const { article, locale } = Astro.props;
const copy = t(locale);
const dateValue = article.displayDate;
---

<article class="group grid gap-0 md:grid-cols-[1fr_1.2fr] md:items-stretch">
  <a href={`/${locale}/bai-viet/${article.slug}`} class="relative min-h-52 overflow-hidden bg-mist sm:min-h-64">
    {article.cover?.url ? (
      <img
        src={article.cover.url}
        alt={article.cover.alternativeText || article.title}
        class="h-full w-full object-cover transition duration-[900ms] group-hover:scale-[1.03]"
        loading="lazy"
        decoding="async"
        width={article.cover.width || 1200}
        height={article.cover.height || 800}
      />
    ) : (
      <div class="flex h-full min-h-52 items-end bg-gradient-to-br from-celadon/35 via-mist to-sand/40 p-6 sm:min-h-64">
        <span class="font-display text-4xl text-ink/20">{article.title.slice(0, 1)}</span>
      </div>
    )}
  </a>
  <div class="flex flex-col justify-center py-7 md:px-10 md:py-8">
    {dateValue && <p class="eyebrow">{formatDate(dateValue, locale)}</p>}
    <h3 class="display-title mt-3 text-2xl text-ink sm:text-3xl">
      <a href={`/${locale}/bai-viet/${article.slug}`}>{article.title}</a>
    </h3>
    {article.excerpt && (
      <p class="mt-4 max-w-xl text-sm leading-relaxed text-ink/60 sm:text-base">{article.excerpt}</p>
    )}
    <a
      href={`/${locale}/bai-viet/${article.slug}`}
      class="mt-6 inline-flex w-fit text-xs font-semibold uppercase tracking-[0.16em] text-celadon-deep underline-offset-4 hover:underline"
    >
      {copy.articles.readMore}
    </a>
  </div>
</article>
