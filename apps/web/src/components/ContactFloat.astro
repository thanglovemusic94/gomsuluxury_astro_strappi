---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import type { SiteSetting } from '../lib/types';

type Props = {
  locale: Locale;
  settings: SiteSetting;
};

const { locale, settings } = Astro.props;
const copy = t(locale);
const phone = settings.phone?.replace(/\s+/g, '') || '';
const zalo = settings.zaloUrl || (phone ? `https://zalo.me/${phone}` : '');
---

<div class="contact-float" aria-label={copy.cta.contact}>
  {phone && (
    <a class="contact-float__btn contact-float__btn--phone" href={`tel:${phone}`} aria-label={settings.phone}>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
        <path
          d="M6.6 3.8c.4-.4 1-.5 1.5-.3l2.3 1c.5.2.8.7.8 1.2v2.2c0 .4-.2.8-.6 1-.8.5-1.2 1.4-1 2.3.5 2.2 2.3 4 4.5 4.5.9.2 1.8-.2 2.3-1 .2-.4.6-.6 1-.6h2.2c.5 0 1 .3 1.2.8l1 2.3c.2.5.1 1.1-.3 1.5-1.4 1.4-3.5 2-5.5 1.5C9.5 19.4 4.6 14.5 3.1 8.3c-.5-2 .1-4.1 1.5-5.5Z"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
        ></path>
      </svg>
      <span class="contact-float__label">{settings.phone}</span>
    </a>
  )}
  {zalo && (
    <a class="contact-float__btn contact-float__btn--zalo" href={zalo} target="_blank" rel="noreferrer" aria-label="Zalo">
      <span class="contact-float__zalo">Zalo</span>
      <span class="contact-float__label">{copy.cta.contact}</span>
    </a>
  )}
</div>
