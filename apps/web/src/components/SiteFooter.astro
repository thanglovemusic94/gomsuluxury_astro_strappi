---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import type { SiteSetting } from '../lib/types';

type Props = {
  locale: Locale;
  settings: SiteSetting;
};

const { locale, settings } = Astro.props;
const copy = t(locale);
const year = new Date().getFullYear();

const productLinks = [
  { label: copy.footer.products.amChen, href: `/${locale}/san-pham?cat=am-chen-bat-trang` },
  { label: copy.footer.products.phuKien, href: `/${locale}/san-pham?cat=phu-kien-ban-tra-gom-su-luxury` },
  { label: copy.footer.products.khayTra, href: `/${locale}/san-pham?cat=khay-tra` },
  { label: copy.footer.products.luXong, href: `/${locale}/san-pham?cat=lu-xong-tram` },
  { label: copy.footer.products.vongTay, href: `/${locale}/san-pham?cat=vong-tay` },
  { label: copy.footer.products.tuong, href: `/${locale}/san-pham?cat=tuong-gom-linh-vat` },
];

const policyLinks = [
  { label: copy.footer.policies.privacy, href: `/${locale}/gioi-thieu` },
  { label: copy.footer.policies.sales, href: `/${locale}/gioi-thieu` },
  { label: copy.footer.policies.return, href: `/${locale}/gioi-thieu` },
  { label: copy.footer.policies.payment, href: `/${locale}/gioi-thieu` },
  { label: copy.footer.policies.shipping, href: `/${locale}/gioi-thieu` },
];

const phone = settings.phone || '0837 571 758';
const address = settings.address || 'Số 04 TT2 Foressa 5A, Xuân Phương, Nam Từ Liêm, Hà Nội';
---

<footer class="site-footer mt-0 text-white">
  <div class="footer-waves" aria-hidden="true">
    <svg class="waves" xmlns="http://www.w3.org/2000/svg" viewBox="0 24 150 28" preserveAspectRatio="none">
      <defs>
        <path id="gentle-wave" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z"></path>
      </defs>
      <g class="parallax">
        <use href="#gentle-wave" x="48" y="0" fill="#bc312a0f"></use>
        <use href="#gentle-wave" x="48" y="3" fill="#bc312a24"></use>
        <use href="#gentle-wave" x="48" y="5" fill="#bc312a3d"></use>
        <use href="#gentle-wave" x="48" y="7" fill="#bc312a"></use>
      </g>
    </svg>
  </div>

  <div class="footer-main header-shine">
    <div class="mx-auto grid max-w-6xl gap-10 section-pad py-12 sm:py-14 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-4">
        <img
          src="/brand/footer-logo.png"
          alt={settings.siteName || copy.brand}
          class="h-14 w-auto max-w-[240px] object-contain sm:h-[4.25rem]"
          width="240"
          height="70"
          loading="lazy"
          decoding="async"
        />
        <h4 class="mt-5 text-center text-sm font-semibold uppercase leading-relaxed tracking-[0.04em] text-white sm:text-[15px]">
          {copy.footer.company}
        </h4>
        <p class="mt-3 text-sm leading-relaxed text-white/85">{copy.footer.blurb}</p>
        <ul class="mt-5 space-y-2 text-sm text-white/90">
          <li>{address}</li>
          <li>
            <a class="hover:text-sand" href={`tel:${phone.replace(/\s+/g, '')}`}>TEL: {phone}</a>
          </li>
        </ul>
        <img
          src="/brand/footer-seal.png"
          alt=""
          class="mt-6 h-16 w-auto object-contain sm:h-20"
          width="140"
          height="80"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="md:col-span-4">
        <p class="footer-col-title">{copy.footer.productsTitle}</p>
        <ul class="footer-link-list mt-4">
          {productLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-4">
        <p class="footer-col-title">{copy.footer.policiesTitle}</p>
        <ul class="footer-link-list mt-4">
          {policyLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
        <div class="mt-6 flex flex-wrap gap-4 text-sm">
          <a class="hover:text-sand" href={settings.facebookUrl || 'https://www.facebook.com/gomsuluxury'} target="_blank" rel="noreferrer">Facebook</a>
          <a class="hover:text-sand" href={settings.instagramUrl || 'https://www.tiktok.com/@gomluxury'} target="_blank" rel="noreferrer">@gomluxury</a>
          {settings.zaloUrl && (
            <a class="hover:text-sand" href={settings.zaloUrl} target="_blank" rel="noreferrer">Zalo</a>
          )}
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bar">
    <div class="mx-auto px-4 py-3 text-center text-sm text-ink/80 sm:px-5 md:px-8">
      Copyright {year} © <strong>gomsuluxury.vn</strong>
    </div>
  </div>
</footer>
