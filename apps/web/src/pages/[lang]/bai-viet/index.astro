---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/article/ArticleCard.astro';
import { isLocale, t, type Locale } from '../../../i18n/ui';
import { getArticles, getMenus, getSiteSettings } from '../../../lib/strapi';

export function getStaticPaths() {
  return [{ params: { lang: 'vi' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang || 'vi';
if (!isLocale(lang)) return Astro.redirect('/vi');
const locale = lang as Locale;
const copy = t(locale);

const [settings, menus, articles] = await Promise.all([
  getSiteSettings(locale),
  getMenus(locale),
  getArticles(locale),
]);
const headerMenu = menus.find((m) => m.location === 'header')?.items || [];
---

<BaseLayout
  locale={locale}
  settings={settings}
  menuItems={headerMenu}
  title={`${copy.articles.title} | ${settings.siteName}`}
  description={copy.articles.subtitle}
>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-5 sm:py-16 md:px-8">
    <p class="text-[10px] uppercase tracking-[0.2em] text-copper sm:text-xs">{copy.brand}</p>
    <h1 class="mt-3 font-display text-3xl font-semibold sm:text-4xl md:text-5xl">{copy.articles.title}</h1>
    <p class="mt-4 max-w-2xl text-sm text-ink/65 sm:text-base">{copy.articles.subtitle}</p>
    <div class="mt-8 space-y-6 sm:mt-12 sm:space-y-8">
      {articles.map((article) => (
        <ArticleCard article={article} locale={locale} />
      ))}
    </div>
  </section>
</BaseLayout>
