{
  "name": "gomsuluxury",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/cms"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:cms": "npm run develop --workspace=cms",
    "build:web": "npm run build --workspace=web",
    "build:cms": "npm run build --workspace=cms",
    "parity:home": "node scripts/parity-home.mjs",
    "docker:up": "docker compose up -d db cms",
    "docker:full": "docker compose --profile full up -d --build"
  },
  "engines": {
    "node": ">=22"
  }
}
