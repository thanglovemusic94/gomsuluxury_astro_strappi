---
import type { Locale } from '../../i18n/ui';
import { t } from '../../i18n/ui';
import type { Article } from '../../lib/types';
import { formatDate } from '../../lib/format';

type Props = {
  article: Article;
  locale: Locale;
};

const { article, locale } = Astro.props;
const copy = t(locale);
const dateValue = article.displayDate;
---

<article class="group grid overflow-hidden md:grid-cols-[1fr_1.15fr]">
  <a href={`/${locale}/bai-viet/${article.slug}`} class="relative min-h-48 overflow-hidden bg-mist sm:min-h-56">
    {article.cover?.url ? (
      <img
        src={article.cover.url}
        alt={article.cover.alternativeText || article.title}
        class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <div class="flex h-full min-h-48 items-end bg-gradient-to-br from-celadon/40 via-mist to-sand/40 p-6 sm:min-h-56">
        <span class="font-display text-3xl text-ink/25">{article.title.slice(0, 1)}</span>
      </div>
    )}
  </a>
  <div class="flex flex-col justify-center px-5 py-7 sm:px-6 sm:py-8 md:px-10">
    {dateValue && (
      <p class="text-[10px] uppercase tracking-[0.16em] text-copper sm:text-xs">{formatDate(dateValue, locale)}</p>
    )}
    <h3 class="mt-3 font-display text-xl font-semibold text-ink sm:text-2xl">
      <a href={`/${locale}/bai-viet/${article.slug}`}>{article.title}</a>
    </h3>
    <p class="mt-3 text-sm leading-relaxed text-ink/65">{article.excerpt}</p>
    <a
      href={`/${locale}/bai-viet/${article.slug}`}
      class="mt-5 inline-flex min-h-11 w-fit items-center text-sm font-semibold uppercase tracking-[0.12em] text-celadon-deep underline-offset-4 hover:underline"
    >
      {copy.articles.readMore}
    </a>
  </div>
</article>
