---
import type { Locale } from '../../i18n/ui';
import { t } from '../../i18n/ui';
import type { Product } from '../../lib/types';
import { discountedPrice, formatPrice } from '../../lib/format';

type Props = {
  product: Product;
  locale: Locale;
};

const { product, locale } = Astro.props;
const copy = t(locale);
const finalPrice = discountedPrice(product.price, product.promotions);
const image = product.images?.[0];
---

<article class="group relative flex flex-col">
  <a href={`/${locale}/san-pham/${product.slug}`} class="block overflow-hidden bg-mist">
    <div class="relative aspect-[4/5] overflow-hidden">
      {image ? (
        <img
          src={image.url}
          alt={image.alternativeText || product.name}
          class="h-full w-full object-cover transition duration-[900ms] ease-out group-hover:scale-[1.04]"
          loading="lazy"
          decoding="async"
          width={image.width || 800}
          height={image.height || 1000}
          sizes="(min-width:1024px) 33vw, (min-width:640px) 50vw, 100vw"
        />
      ) : (
        <div class="flex h-full w-full items-end bg-gradient-to-br from-celadon/35 via-mist to-sand/45 p-5 sm:p-6">
          <span class="font-display text-4xl text-ink/25">{product.name.slice(0, 1)}</span>
        </div>
      )}
    </div>
  </a>
  <div class="mt-4 space-y-1.5">
    {product.isHot && (
      <p class="text-[10px] uppercase tracking-[0.2em] text-copper">{copy.products.hot}</p>
    )}
    <h3 class="display-title text-lg text-ink sm:text-xl">
      <a href={`/${locale}/san-pham/${product.slug}`}>{product.name}</a>
    </h3>
    <p class="text-sm leading-relaxed text-ink/55 line-clamp-2">{product.shortDescription}</p>
    <div class="flex flex-wrap items-baseline gap-2 pt-1">
      <span class="text-sm font-medium text-celadon-deep">{formatPrice(finalPrice, locale)}</span>
      {finalPrice < product.price && (
        <span class="text-xs text-ink/35 line-through">{formatPrice(product.price, locale)}</span>
      )}
    </div>
  </div>
</article>
