---
import '../styles/global.css';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import type { MenuItem, SiteSetting, SeoFields } from '../lib/types';
import type { LocalePathMap } from '../lib/strapi';
import SeoHead from '../components/seo/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

type Props = {
  locale: Locale;
  settings: SiteSetting;
  menuItems: MenuItem[];
  seo?: SeoFields;
  title?: string;
  description?: string;
  localeLinks?: LocalePathMap;
  /** Transparent header over a full-bleed hero */
  overlayHeader?: boolean;
};

const {
  locale,
  settings,
  menuItems,
  seo,
  title,
  description,
  localeLinks,
  overlayHeader = false,
} = Astro.props;
const copy = t(locale);
const pageTitle = seo?.metaTitle || title || settings.defaultSeo?.metaTitle || settings.siteName;
const pageDescription =
  seo?.metaDescription || description || settings.defaultSeo?.metaDescription || settings.tagline || '';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/brand/logo-mark.png" />
    <link rel="apple-touch-icon" href="/brand/logo-mark.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Outfit:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <SeoHead
      title={pageTitle}
      description={pageDescription}
      locale={locale}
      seo={seo || settings.defaultSeo}
      siteName={settings.siteName}
    />
  </head>
  <body>
    <SiteHeader
      locale={locale}
      brand={settings.siteName || copy.brand}
      items={menuItems}
      logo={settings.logo}
      localeLinks={localeLinks}
      overlay={overlayHeader}
    />
    <main>
      <slot />
    </main>
    <SiteFooter locale={locale} settings={settings} />

    <script>
      const revealEls = document.querySelectorAll('.js-reveal');
      if (revealEls.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
