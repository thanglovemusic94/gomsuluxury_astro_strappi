---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/product/ProductCard.astro';
import { isLocale, localePaths, t, type Locale } from '../../../i18n/ui';
import { getMenus, getProducts, getSiteSettings } from '../../../lib/strapi';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang || 'vi';
if (!isLocale(lang)) return Astro.redirect('/vi');
const locale = lang as Locale;
const copy = t(locale);

const [settings, menus, products] = await Promise.all([
  getSiteSettings(locale),
  getMenus(locale),
  getProducts(locale),
]);
const headerMenu = menus.find((m) => m.location === 'header')?.items || [];
---

<BaseLayout
  locale={locale}
  settings={settings}
  menuItems={headerMenu}
  title={`${copy.products.title} | ${settings.siteName}`}
  description={copy.products.subtitle}
>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-5 sm:py-16 md:px-8">
    <p class="text-[10px] uppercase tracking-[0.2em] text-copper sm:text-xs">{copy.brand}</p>
    <h1 class="mt-3 font-display text-3xl font-semibold sm:text-4xl md:text-5xl">{copy.products.title}</h1>
    <p class="mt-4 max-w-2xl text-sm text-ink/65 sm:text-base">{copy.products.subtitle}</p>
    <div class="mt-8 grid gap-6 sm:mt-12 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3">
      {products.map((product) => (
        <ProductCard product={product} locale={locale} />
      ))}
    </div>
  </section>
</BaseLayout>
