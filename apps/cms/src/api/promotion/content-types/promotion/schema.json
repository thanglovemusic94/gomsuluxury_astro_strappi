{
  "kind": "collectionType",
  "collectionName": "promotions",
  "info": {
    "singularName": "promotion",
    "pluralName": "promotions",
    "displayName": "Promotion",
    "description": "Khuyến mãi / giảm giá"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "discountType": {
      "type": "enumeration",
      "enum": ["percent", "fixed"],
      "default": "percent",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "discountValue": {
      "type": "decimal",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "startDate": {
      "type": "datetime",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "endDate": {
      "type": "datetime",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "badgeLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "inversedBy": "promotions"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
