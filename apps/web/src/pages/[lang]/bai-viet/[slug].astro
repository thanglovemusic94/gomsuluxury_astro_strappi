---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/article/ArticleCard.astro';
import { isLocale, locales, t, type Locale } from '../../../i18n/ui';
import { formatDate } from '../../../lib/format';
import { getArticleBySlug, getArticles, getMenus, getSiteSettings } from '../../../lib/strapi';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of locales) {
    const articles = await getArticles(lang);
    for (const article of articles) {
      paths.push({ params: { lang, slug: article.slug } });
    }
  }
  return paths;
}

const lang = Astro.params.lang || 'vi';
const slug = Astro.params.slug || '';
if (!isLocale(lang)) return Astro.redirect('/vi');
const locale = lang as Locale;
const copy = t(locale);

const [settings, menus, article, allArticles] = await Promise.all([
  getSiteSettings(locale),
  getMenus(locale),
  getArticleBySlug(locale, slug),
  getArticles(locale),
]);

if (!article) return Astro.redirect(`/${locale}/bai-viet`);
const headerMenu = menus.find((m) => m.location === 'header')?.items || [];
const related = allArticles.filter((a) => a.slug !== article.slug).slice(0, 2);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.excerpt || article.seo?.metaDescription,
  image: article.cover?.url,
  datePublished: article.displayDate || undefined,
  author: article.authorName
    ? { '@type': 'Person', name: article.authorName }
    : { '@type': 'Organization', name: settings.siteName },
};
---

<BaseLayout
  locale={locale}
  settings={settings}
  menuItems={headerMenu}
  seo={article.seo}
  title={article.seo?.metaTitle || article.title}
  description={article.seo?.metaDescription || article.excerpt}
>
  <article>
    <header class="relative min-h-[42vh] overflow-hidden bg-ink text-porcelain sm:min-h-[48vh]">
      {article.cover?.url ? (
        <img
          src={article.cover.url}
          alt={article.cover.alternativeText || article.title}
          class="absolute inset-0 h-full w-full object-cover"
        />
      ) : (
        <div class="absolute inset-0 bg-gradient-to-br from-ink via-ink-soft to-celadon-deep"></div>
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/55 to-ink/25"></div>
      <div class="relative mx-auto flex min-h-[42vh] max-w-3xl flex-col justify-end px-4 pb-10 pt-20 sm:min-h-[48vh] sm:px-5 sm:pb-12 md:px-8">
        <p class="text-[10px] uppercase tracking-[0.2em] text-sand sm:text-xs">{copy.articles.title}</p>
        <h1 class="mt-3 font-display text-3xl font-semibold sm:text-4xl md:text-5xl">{article.title}</h1>
        <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm text-porcelain/70">
          {article.displayDate && <span>{formatDate(article.displayDate, locale)}</span>}
          {article.authorName && (
            <span>
              {copy.articles.by}: {article.authorName}
            </span>
          )}
        </div>
      </div>
    </header>

    <section class="mx-auto max-w-3xl px-4 py-10 sm:px-5 sm:py-14 md:px-8">
      {article.excerpt && <p class="text-lg text-ink/70">{article.excerpt}</p>}
      {article.content && (
        <div class="prose prose-neutral mt-8 max-w-none text-sm text-ink/80 sm:text-base" set:html={article.content} />
      )}
    </section>
  </article>

  {related.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-5 sm:pb-20 md:px-8">
      <h2 class="font-display text-xl font-semibold sm:text-2xl">{copy.articles.related}</h2>
      <div class="mt-6 space-y-6 sm:mt-8 sm:space-y-8">
        {related.map((item) => (
          <ArticleCard article={item} locale={locale} />
        ))}
      </div>
    </section>
  )}

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
