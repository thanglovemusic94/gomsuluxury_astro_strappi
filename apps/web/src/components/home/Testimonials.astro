---
import type { Locale } from '../../i18n/ui';
import { t } from '../../i18n/ui';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const copy = t(locale);
---

<section class="content-auto border-y border-ink/8 bg-[#faf7f2]">
  <div class="mx-auto max-w-6xl section-pad py-12 sm:py-14 md:py-16">
    <div class="js-reveal text-center">
      <h2 class="section-heading">{copy.home.testimonialsTitle}</h2>
    </div>
    <div class="mt-8 grid gap-8 md:mt-10 md:grid-cols-[1.1fr_1fr] md:items-center md:gap-12">
      <div class="js-reveal overflow-hidden">
        <img
          src="/brand/reviews.jpg"
          alt={copy.home.testimonialsTitle}
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
          width="1200"
          height="800"
        />
      </div>
      <div class="space-y-8">
        {copy.home.reviews.map((review, i) => (
          <blockquote class={`js-reveal ${i === 1 ? 'js-reveal-delay-1' : i === 2 ? 'js-reveal-delay-2' : ''}`}>
            <p class="text-[15px] leading-relaxed text-ink/80 sm:text-base">“{review.quote}”</p>
            <footer class="mt-3 text-sm font-semibold text-brand">{review.author}</footer>
          </blockquote>
        ))}
      </div>
    </div>
  </div>
</section>
