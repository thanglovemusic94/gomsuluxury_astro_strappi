---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EventCard from '../../../components/event/EventCard.astro';
import { isLocale, localePaths, t, type Locale } from '../../../i18n/ui';
import { getEvents, getMenus, getSiteSettings } from '../../../lib/strapi';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang || 'vi';
if (!isLocale(lang)) return Astro.redirect('/vi');
const locale = lang as Locale;
const copy = t(locale);

const [settings, menus, events] = await Promise.all([
  getSiteSettings(locale),
  getMenus(locale),
  getEvents(locale),
]);
const headerMenu = menus.find((m) => m.location === 'header')?.items || [];
---

<BaseLayout
  locale={locale}
  settings={settings}
  menuItems={headerMenu}
  title={`${copy.events.title} | ${settings.siteName}`}
  description={copy.events.subtitle}
>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-5 sm:py-16 md:px-8">
    <p class="text-[10px] uppercase tracking-[0.2em] text-copper sm:text-xs">{copy.brand}</p>
    <h1 class="mt-3 font-display text-3xl font-semibold sm:text-4xl md:text-5xl">{copy.events.title}</h1>
    <p class="mt-4 max-w-2xl text-sm text-ink/65 sm:text-base">{copy.events.subtitle}</p>
    <div class="mt-8 space-y-6 sm:mt-12 sm:space-y-8">
      {events.map((event) => (
        <EventCard event={event} locale={locale} />
      ))}
    </div>
  </section>
</BaseLayout>
