---
import type { Locale } from '../../i18n/ui';

type Props = {
  locale: Locale;
};

const { locale: _locale } = Astro.props;

const videos = [
  {
    id: 'mQLhC0XaOW8',
    title: 'Bộ ấm chén Tây Thi gấm vàng - Gốm Sứ Bát Tràng',
  },
  {
    id: 'aymsvfB8HvI',
    title: 'Bộ ấm chén Quả hồng cẩm lai xanh - Gốm sứ Bát Tràng',
  },
  {
    id: 'lxuQanY7LwQ',
    title: 'Bộ ấm chén Giang Tây LH mẫu 04 - NNƯT Tô Thanh Sơn',
  },
];
---

<section class="content-auto border-b border-ink/6">
  <div class="mx-auto max-w-6xl section-pad py-8 sm:py-10">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
      {videos.map((video, i) => (
        <div class:list={['youtube-card', i === 0 && 'max-lg:col-span-2 lg:block', i > 0 && 'max-sm:hidden']}>
          <div class="youtube-card__frame">
            <iframe
              src={`https://www.youtube.com/embed/${video.id}?rel=0`}
              title={video.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
