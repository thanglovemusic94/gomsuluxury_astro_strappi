---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import type { SiteSetting } from '../lib/types';

type Props = {
  locale: Locale;
  settings: SiteSetting;
};

const { locale, settings } = Astro.props;
const copy = t(locale);
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-ink/10 bg-ink text-porcelain sm:mt-20 md:mt-24">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:gap-10 sm:px-5 sm:py-14 md:grid-cols-[1.4fr_1fr_1fr] md:px-8">
    <div>
      <div class="flex items-center gap-3">
        {settings.logo?.url && (
          <img
            src={settings.logo.url}
            alt=""
            width="40"
            height="40"
            class="h-10 w-10 rounded-full object-cover"
          />
        )}
        <p class="font-display text-xl font-semibold sm:text-2xl">{settings.siteName}</p>
      </div>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-porcelain/70">{settings.tagline}</p>
    </div>
    <div class="text-sm leading-relaxed text-porcelain/75">
      {settings.address && <p>{settings.address}</p>}
      {settings.phone && (
        <p class="mt-2">
          <a class="hover:text-sand" href={`tel:${settings.phone.replace(/\s+/g, '')}`}>{settings.phone}</a>
        </p>
      )}
      {settings.email && (
        <p class="mt-1">
          <a class="hover:text-sand" href={`mailto:${settings.email}`}>{settings.email}</a>
        </p>
      )}
    </div>
    <div>
      <p class="text-xs uppercase tracking-[0.18em] text-sand">{copy.footer.follow}</p>
      <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm sm:flex-col sm:gap-2">
        {settings.facebookUrl && <a class="hover:text-sand" href={settings.facebookUrl}>Facebook</a>}
        {settings.instagramUrl && <a class="hover:text-sand" href={settings.instagramUrl}>Instagram</a>}
        {settings.zaloUrl && <a class="hover:text-sand" href={settings.zaloUrl}>Zalo</a>}
      </div>
    </div>
  </div>
  <div class="border-t border-porcelain/10 px-4 py-4 text-center text-xs text-porcelain/50 sm:px-5 md:px-8">
    © {year} {settings.siteName}. {copy.footer.rights}
  </div>
</footer>
