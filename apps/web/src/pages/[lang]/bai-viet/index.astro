---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/article/ArticleCard.astro';
import { isLocale, t, type Locale } from '../../../i18n/ui';
import { getArticles, getMenus, getSiteSettings } from '../../../lib/strapi';

const lang = Astro.params.lang || 'vi';
if (!isLocale(lang)) return Astro.redirect('/vi');
const locale = lang as Locale;
const copy = t(locale);

const [settings, menus, articlesResult] = await Promise.all([
  getSiteSettings(locale),
  getMenus(locale),
  getArticles(locale),
]);
const headerMenu = menus.find((m) => m.location === 'header')?.items || [];
const articles = articlesResult.items;
const fromCms = articlesResult.fromCms;
---

<BaseLayout
  locale={locale}
  settings={settings}
  menuItems={headerMenu}
  title={`${copy.articles.title} | ${settings.siteName}`}
  description={copy.articles.subtitle}
>
  <section class="mx-auto max-w-6xl section-pad py-14 sm:py-16 md:py-20">
    <p class="eyebrow">{copy.brand}</p>
    <h1 class="display-title mt-4 text-4xl sm:text-5xl md:text-6xl">{copy.articles.title}</h1>
    <p class="mt-5 max-w-xl text-sm leading-relaxed text-ink/60 sm:text-base">{copy.articles.subtitle}</p>

    {articles.length === 0 ? (
      <div class="mt-12 max-w-xl text-sm leading-relaxed text-ink/65">
        <p>{copy.articles.empty}</p>
        {fromCms && <p class="mt-3 text-ink/45">{copy.articles.missingLocale}</p>}
      </div>
    ) : (
      <div class="mt-12 space-y-12 sm:mt-16">
        {articles.map((article) => (
          <div class="js-reveal">
            <ArticleCard article={article} locale={locale} />
          </div>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
