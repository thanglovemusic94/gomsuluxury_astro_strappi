---
import type { Locale } from '../../i18n/ui';
import { t } from '../../i18n/ui';
import SectionTitleBar from './SectionTitleBar.astro';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const copy = t(locale);
---

<section class="content-auto bg-[#faf7f2]">
  <SectionTitleBar title={copy.home.testimonialsTitle} />
  <div class="mx-auto max-w-6xl section-pad py-10 sm:py-12 md:py-14">
    <div class="grid gap-8 md:grid-cols-[1.1fr_1fr] md:items-center md:gap-12">
      <div class="overflow-hidden">
        <img
          src="/brand/reviews.jpg"
          alt={copy.home.testimonialsTitle}
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
          width="1200"
          height="800"
        />
      </div>
      <div class="space-y-8">
        {copy.home.reviews.map((review) => (
          <blockquote>
            <p class="text-[15px] leading-relaxed text-ink/80 sm:text-base">“{review.quote}”</p>
            <footer class="mt-3 text-sm font-semibold text-brand">{review.author}</footer>
          </blockquote>
        ))}
      </div>
    </div>
  </div>
</section>
