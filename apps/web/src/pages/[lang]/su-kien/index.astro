---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EventCard from '../../../components/event/EventCard.astro';
import { isLocale, localePaths, t, type Locale } from '../../../i18n/ui';
import { getEvents, getMenus, getSiteSettings } from '../../../lib/strapi';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang || 'vi';
if (!isLocale(lang)) return Astro.redirect('/vi');
const locale = lang as Locale;
const copy = t(locale);

const [settings, menus, events] = await Promise.all([
  getSiteSettings(locale),
  getMenus(locale),
  getEvents(locale),
]);
const headerMenu = menus.find((m) => m.location === 'header')?.items || [];
---

<BaseLayout
  locale={locale}
  settings={settings}
  menuItems={headerMenu}
  title={`${copy.events.title} | ${settings.siteName}`}
  description={copy.events.subtitle}
>
  <section class="mx-auto max-w-6xl section-pad py-14 sm:py-16 md:py-20">
    <p class="eyebrow">{copy.brand}</p>
    <h1 class="display-title mt-4 text-4xl sm:text-5xl md:text-6xl">{copy.events.title}</h1>
    <p class="mt-5 max-w-xl text-sm leading-relaxed text-ink/60 sm:text-base">{copy.events.subtitle}</p>
    <div class="mt-12 space-y-12 sm:mt-16">
      {events.map((event) => (
        <div class="js-reveal">
          <EventCard event={event} locale={locale} />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
