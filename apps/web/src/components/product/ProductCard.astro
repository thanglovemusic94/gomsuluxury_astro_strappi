---
import type { Locale } from '../../i18n/ui';
import { t } from '../../i18n/ui';
import type { Product } from '../../lib/types';
import { discountedPrice, formatPrice } from '../../lib/format';

type Props = {
  product: Product;
  locale: Locale;
};

const { product, locale } = Astro.props;
const copy = t(locale);
const finalPrice = discountedPrice(product.price, product.promotions);
const badge = product.promotions?.find((p) => p.isActive !== false)?.badgeLabel;
const image = product.images?.[0];
---

<article class="group relative flex flex-col">
  <a href={`/${locale}/san-pham/${product.slug}`} class="block overflow-hidden bg-mist">
    <div class="relative aspect-[4/5] overflow-hidden">
      {image ? (
        <img
          src={image.url}
          alt={image.alternativeText || product.name}
          class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full w-full items-end bg-gradient-to-br from-celadon/40 via-mist to-sand/50 p-5 sm:p-6">
          <span class="font-display text-3xl text-ink/30">{product.name.slice(0, 1)}</span>
        </div>
      )}
      {(product.isHot || badge) && (
        <div class="absolute left-3 top-3 flex flex-wrap gap-2">
          {product.isHot && (
            <span class="bg-ink px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-porcelain">
              {copy.products.hot}
            </span>
          )}
          {badge && (
            <span class="bg-copper px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-porcelain">
              {badge}
            </span>
          )}
        </div>
      )}
    </div>
  </a>
  <div class="mt-3 space-y-1 sm:mt-4">
    <h3 class="font-display text-base font-semibold text-ink sm:text-lg">
      <a href={`/${locale}/san-pham/${product.slug}`}>{product.name}</a>
    </h3>
    <p class="text-sm text-ink/60 line-clamp-2">{product.shortDescription}</p>
    <div class="flex flex-wrap items-baseline gap-2 pt-1">
      <span class="text-sm font-semibold text-celadon-deep">{formatPrice(finalPrice, locale)}</span>
      {finalPrice < product.price && (
        <span class="text-xs text-ink/40 line-through">{formatPrice(product.price, locale)}</span>
      )}
    </div>
  </div>
</article>
