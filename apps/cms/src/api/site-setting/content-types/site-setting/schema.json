{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site Setting",
    "description": "Cấu hình chung website"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "siteName": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "tagline": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "craftImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "phone": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "email": {
      "type": "email",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "address": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "zaloUrl": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "facebookUrl": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "instagramUrl": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "defaultSeo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
