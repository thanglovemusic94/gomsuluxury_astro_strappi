---
import type { Locale } from '../i18n/ui';
import { locales, localeLabels, t } from '../i18n/ui';
import type { MenuItem, StrapiMedia } from '../lib/types';
import type { LocalePathMap } from '../lib/strapi';

type Props = {
  locale: Locale;
  brand: string;
  items: MenuItem[];
  logo?: StrapiMedia | null;
  localeLinks?: LocalePathMap;
  overlay?: boolean;
};

const { locale, brand, items, logo, localeLinks, overlay = false } = Astro.props;
const copy = t(locale);
const sorted = [...items].sort((a, b) => (a.order || 0) - (b.order || 0));

function switchLocalePath(next: Locale) {
  if (localeLinks?.[next]) return localeLinks[next]!;
  const parts = Astro.url.pathname.split('/');
  if (parts[1] && locales.includes(parts[1] as Locale)) {
    parts[1] = next;
    return parts.join('/') || `/${next}`;
  }
  return `/${next}`;
}
---

<header
  id="site-header"
  class:list={['site-header', overlay ? 'is-overlay' : 'is-solid']}
  data-overlay={overlay ? 'true' : 'false'}
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-5 sm:py-4 md:px-8">
    <a
      href={`/${locale}`}
      class="header-brand flex min-w-0 items-center gap-2.5 font-display text-lg font-semibold tracking-tight sm:gap-3 sm:text-xl md:text-2xl"
    >
      {logo?.url ? (
        <img
          src={logo.url}
          alt={brand}
          width="40"
          height="40"
          class="h-9 w-9 shrink-0 object-contain sm:h-10 sm:w-10"
          decoding="async"
        />
      ) : null}
      <span class="truncate">{brand}</span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
      {sorted.map((item) => (
        <a
          href={item.url}
          class="header-link text-sm font-medium text-ink/65 transition hover:text-celadon-deep"
          target={item.openInNewTab ? '_blank' : undefined}
          rel={item.openInNewTab ? 'noreferrer' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      <nav class="header-locale hidden items-center gap-1 text-[11px] uppercase tracking-[0.14em] sm:flex" aria-label={copy.langLabel}>
        {locales.map((l, index) => (
          <>
            {index > 0 && <span class="text-current/35" aria-hidden="true">·</span>}
            <a
              href={switchLocalePath(l)}
              class:list={[
                'px-1 transition hover:opacity-100',
                l === locale ? 'font-semibold opacity-100' : 'opacity-55',
              ]}
              aria-current={l === locale ? 'true' : undefined}
            >
              {localeLabels[l]}
            </a>
          </>
        ))}
      </nav>

      <a
        href={`/${locale}/san-pham`}
        class="header-cta hidden px-3 py-2.5 text-[10px] font-semibold uppercase tracking-[0.12em] transition sm:inline-block sm:px-4 sm:text-xs sm:tracking-[0.14em] bg-ink text-porcelain hover:bg-celadon-deep"
      >
        {copy.cta.explore}
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="header-icon inline-flex h-10 w-10 items-center justify-center border border-ink/15 text-ink lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={copy.menuOpen}
        data-label-open={copy.menuOpen}
        data-label-close={copy.menuClose}
      >
        <span class="sr-only">{copy.menuOpen}</span>
        <svg id="icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
        </svg>
        <svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-ink/10 bg-porcelain text-ink lg:hidden" hidden>
    <nav class="mx-auto flex max-w-6xl flex-col px-4 py-3 sm:px-5" aria-label="Mobile">
      {sorted.map((item) => (
        <a
          href={item.url}
          class="border-b border-ink/8 py-3.5 text-base font-medium text-ink/80 transition hover:text-celadon-deep"
          target={item.openInNewTab ? '_blank' : undefined}
          rel={item.openInNewTab ? 'noreferrer' : undefined}
        >
          {item.label}
        </a>
      ))}
      <div class="mt-4 flex items-center gap-3 text-xs uppercase tracking-[0.16em]">
        {locales.map((l) => (
          <a
            href={switchLocalePath(l)}
            class:list={[l === locale ? 'font-semibold text-ink' : 'text-ink/45']}
            aria-current={l === locale ? 'true' : undefined}
          >
            {localeLabels[l]}
          </a>
        ))}
      </div>
      <a
        href={`/${locale}/san-pham`}
        class="mt-4 mb-2 inline-flex items-center justify-center bg-ink px-4 py-3.5 text-xs font-semibold uppercase tracking-[0.14em] text-porcelain"
      >
        {copy.cta.explore}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const header = document.getElementById('site-header');

  if (toggle && menu) {
    const setOpen = (open) => {
      toggle.setAttribute('aria-expanded', String(open));
      const label = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen;
      if (label) toggle.setAttribute('aria-label', label);
      menu.classList.toggle('hidden', !open);
      menu.hidden = !open;
      document.body.classList.toggle('overflow-hidden', open);
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
      if (open && header?.dataset.overlay === 'true') {
        header.classList.add('is-scrolled');
      }
    };

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });

    window.addEventListener('resize', () => {
      if (window.matchMedia('(min-width: 1024px)').matches) setOpen(false);
    });
  }

  if (header?.dataset.overlay === 'true') {
    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 24);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
