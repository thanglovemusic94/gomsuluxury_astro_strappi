---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/product/ProductCard.astro';
import { isLocale, t, type Locale } from '../../../i18n/ui';
import { discountedPrice, formatPrice } from '../../../lib/format';
import { getMenus, getProductBySlug, getProducts, getSiteSettings } from '../../../lib/strapi';

const lang = Astro.params.lang || 'vi';
const slug = Astro.params.slug || '';
if (!isLocale(lang)) return Astro.redirect('/vi');
const locale = lang as Locale;
const copy = t(locale);

const [settings, menus, product, allProducts] = await Promise.all([
  getSiteSettings(locale),
  getMenus(locale),
  getProductBySlug(locale, slug),
  getProducts(locale),
]);

if (!product) return Astro.redirect(`/${locale}/san-pham`);

const headerMenu = menus.find((m) => m.location === 'header')?.items || [];
const finalPrice = discountedPrice(product.price, product.promotions);
const related = allProducts.filter((p) => p.slug !== product.slug).slice(0, 3);
const inStock = !product.trackInventory || product.stock > 0;
const images = product.images || [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.shortDescription || product.seo?.metaDescription,
  sku: product.sku,
  image: images.map((i) => i.url),
  offers: {
    '@type': 'Offer',
    priceCurrency: 'VND',
    price: finalPrice,
    availability: inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
  },
};
---

<BaseLayout
  locale={locale}
  settings={settings}
  menuItems={headerMenu}
  seo={product.seo}
  title={product.seo?.metaTitle || product.name}
  description={product.seo?.metaDescription || product.shortDescription}
>
  <section class="mx-auto grid max-w-6xl gap-10 section-pad py-10 sm:gap-12 sm:py-14 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
    <div class="space-y-3">
      <div class="overflow-hidden bg-mist">
        {images[0] ? (
          <img
            src={images[0].url}
            alt={images[0].alternativeText || product.name}
            class="aspect-[4/5] w-full object-cover"
            fetchpriority="high"
            decoding="async"
            width={images[0].width || 1000}
            height={images[0].height || 1250}
          />
        ) : (
          <div class="flex aspect-[4/5] items-end bg-gradient-to-br from-celadon/30 via-mist to-sand/40 p-8">
            <span class="font-display text-6xl text-ink/15">{product.name.slice(0, 1)}</span>
          </div>
        )}
      </div>
      {images.length > 1 && (
        <div class="grid grid-cols-3 gap-3">
          {images.slice(1, 4).map((img) => (
            <div class="overflow-hidden bg-mist">
              <img
                src={img.url}
                alt={img.alternativeText || product.name}
                class="aspect-square w-full object-cover"
                loading="lazy"
                decoding="async"
                width={img.width || 400}
                height={img.height || 400}
              />
            </div>
          ))}
        </div>
      )}
    </div>

    <div class="lg:sticky lg:top-28">
      {product.isHot && <p class="eyebrow">{copy.products.hot}</p>}
      <h1 class="display-title mt-3 text-3xl sm:text-4xl md:text-5xl">{product.name}</h1>
      {product.shortDescription && (
        <p class="mt-5 text-sm leading-relaxed text-ink/60 sm:text-base">{product.shortDescription}</p>
      )}

      <div class="mt-8 flex flex-wrap items-baseline gap-3 border-t border-ink/10 pt-6">
        <span class="text-2xl font-medium text-celadon-deep">{formatPrice(finalPrice, locale)}</span>
        {finalPrice < product.price && (
          <span class="text-sm text-ink/35 line-through">{formatPrice(product.price, locale)}</span>
        )}
      </div>

      <p class="mt-3 text-sm text-ink/50">
        {inStock ? `${copy.products.stock}: ${product.stock}` : copy.products.outOfStock}
        {product.sku && ` · ${copy.products.sku}: ${product.sku}`}
      </p>

      {product.attributeValues && product.attributeValues.length > 0 && (
        <div class="mt-8">
          <h2 class="eyebrow">{copy.products.attributes}</h2>
          <dl class="mt-4 space-y-0">
            {product.attributeValues.map((attr) => (
              <div class="flex justify-between gap-4 border-b border-ink/8 py-3 text-sm">
                <dt class="text-ink/50">{attr.name}</dt>
                <dd class="text-right font-medium">{attr.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      )}

      <a href={settings.zaloUrl || '#'} class="btn-primary mt-8 w-full sm:mt-10 sm:w-auto">
        {copy.cta.contact}
      </a>

      {product.description && (
        <div class="mt-10 max-w-none text-sm leading-relaxed text-ink/70 [&_p]:mt-3" set:html={product.description} />
      )}
    </div>
  </section>

  {related.length > 0 && (
    <section class="content-auto mx-auto max-w-6xl section-pad pb-20 sm:pb-24">
      <h2 class="js-reveal display-title text-2xl sm:text-3xl">{copy.products.related}</h2>
      <div class="mt-8 grid gap-8 sm:mt-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-10">
        {related.map((item) => (
          <div class="js-reveal">
            <ProductCard product={item} locale={locale} />
          </div>
        ))}
      </div>
    </section>
  )}

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
