---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import type { SiteSetting } from '../lib/types';

type Props = {
  locale: Locale;
  settings: SiteSetting;
};

const { locale, settings } = Astro.props;
const copy = t(locale);
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-ink/10 bg-ink text-porcelain sm:mt-24">
  <div class="mx-auto grid max-w-6xl gap-10 section-pad py-14 sm:py-16 md:grid-cols-[1.5fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-3">
        {settings.logo?.url && (
          <img
            src={settings.logo.url}
            alt=""
            width="40"
            height="40"
            class="h-10 w-10 object-cover"
            loading="lazy"
            decoding="async"
          />
        )}
        <p class="font-display text-2xl font-semibold tracking-tight">{settings.siteName}</p>
      </div>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-porcelain/60">{settings.tagline}</p>
    </div>
    <div class="text-sm leading-relaxed text-porcelain/65">
      {settings.address && <p>{settings.address}</p>}
      {settings.phone && (
        <p class="mt-3">
          <a class="transition hover:text-sand" href={`tel:${settings.phone.replace(/\s+/g, '')}`}>{settings.phone}</a>
        </p>
      )}
      {settings.email && (
        <p class="mt-1">
          <a class="transition hover:text-sand" href={`mailto:${settings.email}`}>{settings.email}</a>
        </p>
      )}
    </div>
    <div>
      <p class="eyebrow text-sand">{copy.footer.follow}</p>
      <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm sm:flex-col sm:gap-2">
        {settings.facebookUrl && <a class="transition hover:text-sand" href={settings.facebookUrl}>Facebook</a>}
        {settings.instagramUrl && <a class="transition hover:text-sand" href={settings.instagramUrl}>Instagram</a>}
        {settings.zaloUrl && <a class="transition hover:text-sand" href={settings.zaloUrl}>Zalo</a>}
      </div>
    </div>
  </div>
  <div class="border-t border-porcelain/10 px-4 py-4 text-center text-xs text-porcelain/40 sm:px-5 md:px-8">
    © {year} {settings.siteName}. {copy.footer.rights}
  </div>
</footer>
