---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLocale, locales, type Locale } from '../../i18n/ui';
import { demoPages } from '../../lib/demo-data';
import { getMenus, getPageBySlug, getSiteSettings } from '../../lib/strapi';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of locales) {
    const pages = demoPages(lang);
    for (const page of pages) {
      paths.push({ params: { lang, slug: page.slug } });
    }
  }
  return paths;
}

const lang = Astro.params.lang || 'vi';
const slug = Astro.params.slug || '';
if (!isLocale(lang)) return Astro.redirect('/vi');
const locale = lang as Locale;

const [settings, menus, page] = await Promise.all([
  getSiteSettings(locale),
  getMenus(locale),
  getPageBySlug(locale, slug),
]);

if (!page) return Astro.redirect(`/${locale}`);
const headerMenu = menus.find((m) => m.location === 'header')?.items || [];
---

<BaseLayout
  locale={locale}
  settings={settings}
  menuItems={headerMenu}
  seo={page.seo}
  title={page.seo?.metaTitle || page.title}
  description={page.seo?.metaDescription || page.excerpt}
>
  {page.heroImage?.url ? (
    <header class="relative min-h-[42svh] overflow-hidden bg-ink text-porcelain sm:min-h-[48svh]">
      <img
        src={page.heroImage.url}
        alt={page.heroImage.alternativeText || page.title}
        class="absolute inset-0 h-full w-full object-cover"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/50 to-ink/20"></div>
      <div class="relative mx-auto flex min-h-[42svh] max-w-3xl flex-col justify-end section-pad pb-10 pt-24 sm:min-h-[48svh] sm:pb-14">
        <h1 class="display-title text-4xl text-porcelain sm:text-5xl">{page.title}</h1>
      </div>
    </header>
  ) : (
    <div class="mx-auto max-w-3xl section-pad pt-14 sm:pt-16">
      <h1 class="display-title text-4xl sm:text-5xl">{page.title}</h1>
    </div>
  )}

  <section class="mx-auto max-w-[42rem] section-pad py-12 sm:py-16">
    {page.excerpt && <p class="js-reveal text-xl leading-relaxed text-ink/60 sm:text-2xl">{page.excerpt}</p>}
    {page.content && (
      <div class="js-reveal prose-article mt-8" set:html={page.content} />
    )}
  </section>
</BaseLayout>
