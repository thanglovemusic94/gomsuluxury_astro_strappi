---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';
import ProductCard from '../../components/product/ProductCard.astro';
import EventCard from '../../components/event/EventCard.astro';
import { isLocale, t, type Locale } from '../../i18n/ui';
import { getEvents, getMenus, getProducts, getSiteSettings } from '../../lib/strapi';

export function getStaticPaths() {
  return [{ params: { lang: 'vi' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang || 'vi';
if (!isLocale(lang)) {
  return Astro.redirect('/vi');
}
const locale = lang as Locale;
const copy = t(locale);

const [settings, menus, hotProducts, events] = await Promise.all([
  getSiteSettings(locale),
  getMenus(locale),
  getProducts(locale, { hot: true }),
  getEvents(locale),
]);

const headerMenu = menus.find((m) => m.location === 'header')?.items || [];
const featuredEvents = events.filter((e) => e.isFeatured).slice(0, 2);
---

<BaseLayout locale={locale} settings={settings} menuItems={headerMenu}>
  <Hero locale={locale} image={settings.heroImage} />

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-5 sm:py-16 md:px-8 md:py-20">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between sm:gap-4">
      <div>
        <p class="text-[10px] uppercase tracking-[0.2em] text-copper sm:text-xs">{copy.home.hot}</p>
        <h2 class="mt-2 font-display text-2xl font-semibold sm:text-3xl md:text-4xl">{copy.products.title}</h2>
      </div>
      <a href={`/${locale}/san-pham`} class="text-sm font-medium text-celadon-deep hover:underline">
        {copy.cta.viewAll}
      </a>
    </div>
    <div class="mt-8 grid gap-6 sm:mt-10 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3">
      {hotProducts.slice(0, 3).map((product) => (
        <ProductCard product={product} locale={locale} />
      ))}
    </div>
  </section>

  <section class="bg-ink py-14 text-porcelain sm:py-16 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 sm:gap-10 sm:px-5 md:grid-cols-2 md:items-center md:px-8">
      <div>
        <h2 class="font-display text-2xl font-semibold sm:text-3xl md:text-5xl">{copy.home.craft}</h2>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-porcelain/70 sm:mt-5 sm:text-base">{copy.home.craftBody}</p>
      </div>
      <div class="relative aspect-[4/3] overflow-hidden bg-ink-soft">
        {settings.craftImage?.url ? (
          <img
            src={settings.craftImage.url}
            alt={settings.craftImage.alternativeText || copy.home.craft}
            class="h-full w-full object-cover"
            loading="lazy"
          />
        ) : (
          <div class="h-full w-full bg-gradient-to-br from-celadon-deep via-ink-soft to-copper/40"></div>
        )}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-5 sm:py-16 md:px-8 md:py-20">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between sm:gap-4">
      <div>
        <p class="text-[10px] uppercase tracking-[0.2em] text-copper sm:text-xs">{copy.home.featuredEvents}</p>
        <h2 class="mt-2 font-display text-2xl font-semibold sm:text-3xl md:text-4xl">{copy.events.title}</h2>
      </div>
      <a href={`/${locale}/su-kien`} class="text-sm font-medium text-celadon-deep hover:underline">
        {copy.cta.viewAll}
      </a>
    </div>
    <div class="mt-8 space-y-6 sm:mt-10 sm:space-y-8">
      {featuredEvents.map((event) => (
        <EventCard event={event} locale={locale} />
      ))}
    </div>
  </section>
</BaseLayout>
