---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/product/ProductCard.astro';
import { isLocale, localePaths, t, type Locale } from '../../../i18n/ui';
import { getMenus, getProducts, getSiteSettings } from '../../../lib/strapi';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang || 'vi';
if (!isLocale(lang)) return Astro.redirect('/vi');
const locale = lang as Locale;
const copy = t(locale);

const [settings, menus, products] = await Promise.all([
  getSiteSettings(locale),
  getMenus(locale),
  getProducts(locale),
]);
const headerMenu = menus.find((m) => m.location === 'header')?.items || [];
---

<BaseLayout
  locale={locale}
  settings={settings}
  menuItems={headerMenu}
  title={`${copy.products.title} | ${settings.siteName}`}
  description={copy.products.subtitle}
>
  <section class="mx-auto max-w-6xl section-pad py-14 sm:py-16 md:py-20">
    <p class="eyebrow">{copy.brand}</p>
    <h1 class="display-title mt-4 text-4xl sm:text-5xl md:text-6xl">{copy.products.title}</h1>
    <p class="mt-5 max-w-xl text-sm leading-relaxed text-ink/60 sm:text-base">{copy.products.subtitle}</p>
    <div class="mt-12 grid gap-8 sm:mt-16 sm:grid-cols-2 lg:grid-cols-3 lg:gap-10">
      {products.map((product, i) => (
        <div class={`js-reveal ${i % 3 === 1 ? 'js-reveal-delay-1' : i % 3 === 2 ? 'js-reveal-delay-2' : ''}`}>
          <ProductCard product={product} locale={locale} />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
