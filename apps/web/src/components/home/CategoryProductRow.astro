---
import type { Locale } from '../../i18n/ui';
import { t } from '../../i18n/ui';
import type { CatalogItem } from '../../lib/home-sections';
import { formatPrice } from '../../lib/format';
import SectionTitleBar from './SectionTitleBar.astro';

type Props = {
  locale: Locale;
  title: string;
  items: CatalogItem[];
  href: string;
  viewMore?: string;
};

const { locale, title, items, href, viewMore } = Astro.props;
const copy = t(locale);
if (!items.length) return;
---

<section class="home-product-row content-auto">
  <SectionTitleBar title={title} actionLabel={viewMore || copy.cta.viewMore} actionHref={href} />

  <div class="mx-auto max-w-6xl section-pad py-8 sm:py-10">
    <div class="product-rail">
      {items.slice(0, 10).map((item) => {
        const price = item.price != null ? Number(item.price) : null;
        const compare = item.compareAtPrice != null ? Number(item.compareAtPrice) : null;
        const onSale = price != null && compare != null && compare > price;
        const discount = onSale && compare ? Math.round((1 - price! / compare) * 100) : 0;
        const link = item.slug ? `/${locale}/san-pham/${item.slug}` : href;
        return (
          <article class="product-rail__item">
            <a href={link} class="block">
              <div class="product-shine relative aspect-square overflow-hidden bg-mist">
                <img
                  src={item.image}
                  alt={item.name}
                  class="h-full w-full object-cover transition duration-500 hover:scale-[1.03]"
                  loading="lazy"
                  decoding="async"
                  width="500"
                  height="500"
                />
                {discount > 0 && <span class="product-badge">-{discount}%</span>}
              </div>
              <h3 class="mt-3 line-clamp-2 text-sm leading-snug text-ink sm:text-[15px]">{item.name}</h3>
              {price != null && price > 0 && (
                <div class="mt-2 flex flex-wrap items-baseline gap-2">
                  <span class="text-sm font-semibold text-brand">{formatPrice(price, locale)}</span>
                  {onSale && compare != null && (
                    <span class="text-xs text-ink/35 line-through">{formatPrice(compare, locale)}</span>
                  )}
                </div>
              )}
            </a>
          </article>
        );
      })}
    </div>
  </div>
</section>
