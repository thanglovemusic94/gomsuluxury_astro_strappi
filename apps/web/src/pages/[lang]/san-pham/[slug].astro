---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/product/ProductCard.astro';
import { isLocale, locales, t, type Locale } from '../../../i18n/ui';
import { discountedPrice, formatPrice } from '../../../lib/format';
import { getMenus, getProductBySlug, getProducts, getSiteSettings } from '../../../lib/strapi';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of locales) {
    const products = await getProducts(lang);
    for (const product of products) {
      paths.push({ params: { lang, slug: product.slug } });
    }
  }
  return paths;
}

const lang = Astro.params.lang || 'vi';
const slug = Astro.params.slug || '';
if (!isLocale(lang)) return Astro.redirect('/vi');
const locale = lang as Locale;
const copy = t(locale);

const [settings, menus, product, allProducts] = await Promise.all([
  getSiteSettings(locale),
  getMenus(locale),
  getProductBySlug(locale, slug),
  getProducts(locale),
]);

if (!product) return Astro.redirect(`/${locale}/san-pham`);

const headerMenu = menus.find((m) => m.location === 'header')?.items || [];
const finalPrice = discountedPrice(product.price, product.promotions);
const related = allProducts.filter((p) => p.slug !== product.slug).slice(0, 3);
const inStock = !product.trackInventory || product.stock > 0;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.shortDescription || product.seo?.metaDescription,
  sku: product.sku,
  image: product.images?.map((i) => i.url),
  offers: {
    '@type': 'Offer',
    priceCurrency: 'VND',
    price: finalPrice,
    availability: inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
  },
};
---

<BaseLayout
  locale={locale}
  settings={settings}
  menuItems={headerMenu}
  seo={product.seo}
  title={product.seo?.metaTitle || product.name}
  description={product.seo?.metaDescription || product.shortDescription}
>
  <section class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-2 md:px-8">
    <div class="overflow-hidden bg-mist">
      {product.images?.[0] ? (
        <img
          src={product.images[0].url}
          alt={product.images[0].alternativeText || product.name}
          class="aspect-[4/5] w-full object-cover"
        />
      ) : (
        <div class="flex aspect-[4/5] items-end bg-gradient-to-br from-celadon/30 via-mist to-sand/40 p-8">
          <span class="font-display text-6xl text-ink/20">{product.name.slice(0, 1)}</span>
        </div>
      )}
    </div>

    <div>
      {product.isHot && (
        <span class="bg-ink px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-porcelain">
          {copy.products.hot}
        </span>
      )}
      <h1 class="mt-4 font-display text-4xl font-semibold md:text-5xl">{product.name}</h1>
      <p class="mt-4 text-ink/65">{product.shortDescription}</p>

      <div class="mt-6 flex items-baseline gap-3">
        <span class="text-2xl font-semibold text-celadon-deep">{formatPrice(finalPrice, locale)}</span>
        {finalPrice < product.price && (
          <span class="text-ink/40 line-through">{formatPrice(product.price, locale)}</span>
        )}
      </div>

      <p class="mt-3 text-sm text-ink/55">
        {inStock ? `${copy.products.stock}: ${product.stock}` : copy.products.outOfStock}
        {product.sku && ` · ${copy.products.sku}: ${product.sku}`}
      </p>

      {product.attributeValues && product.attributeValues.length > 0 && (
        <div class="mt-8">
          <h2 class="text-xs uppercase tracking-[0.18em] text-copper">{copy.products.attributes}</h2>
          <dl class="mt-3 space-y-2">
            {product.attributeValues.map((attr) => (
              <div class="flex justify-between border-b border-ink/10 py-2 text-sm">
                <dt class="text-ink/55">{attr.name}</dt>
                <dd class="font-medium">{attr.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      )}

      {product.description && (
        <div class="prose prose-neutral mt-8 max-w-none text-sm leading-relaxed text-ink/75" set:html={product.description} />
      )}

      <a
        href={settings.zaloUrl || '#'}
        class="mt-10 inline-block bg-ink px-6 py-3 text-xs font-semibold uppercase tracking-[0.16em] text-porcelain hover:bg-celadon-deep"
      >
        {copy.cta.contact}
      </a>
    </div>
  </section>

  {related.length > 0 && (
    <section class="mx-auto max-w-6xl px-5 pb-20 md:px-8">
      <h2 class="font-display text-2xl font-semibold">{copy.products.related}</h2>
      <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((item) => (
          <ProductCard product={item} locale={locale} />
        ))}
      </div>
    </section>
  )}

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
